DATABASE_URL=postgresql://capstone_auth_app:replace-password@your-neon-host/auth-service?sslmode=require&channel_binding=require
PORT=8081
BIND_HOST=127.0.0.1
AUTH_INTERNAL_TOKEN=replace-with-random-token-at-least-32-characters
USER_INTERNAL_TOKEN=replace-with-another-random-token-at-least-32-characters
USER_SERVICE_URL=http://127.0.0.1:8082
COOKIE_SECURE=false
